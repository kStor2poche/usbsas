# vim:noet:
pkgname=usbsas
subpackages="
	usbsas-server:server:all
	usbsas-server-openrc:server_openrc
	usbsas-kiosk:kiosk:all
	usbsas-kiosk-openrc:kiosk_openrc
	usbsas-analyzer-server:analyzer_server:all
	usbsas-analyzer-server-openrc:analyzer_server_openrc
	usbsas-tools:tools:all
	usbsas-hid:hid:all
	usbsas-hid-openrc:hid_openrc
"
pkgver=0.3.4
pkgrel=0
pkgdesc="A free and open source (GPLv3) tool and framework for securely reading untrusted USB mass storage devices. (meta-package)"
license="GPL-3.0-only"
url=https://github.com/cea-sec/usbsas

# _ref="v$pkgver"
_ref="raspi-demo"
# source="$pkgname-$pkgver.tar.gz::https://github.com/cea-sec/usbsas/archive/refs/tags/${_ref}.tar.gz"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/kStor2poche/usbsas/archive/refs/heads/$_ref.tar.gz
	usbsas-server
	usbsas-kiosk
	usbsas-analyzer-server
	hid-dealer
"
install="
	usbsas-server.post-install
	usbsas-server.post-deinstall
	usbsas-kiosk.post-install
	usbsas-kiosk.pre-deinstall
	usbsas-kiosk.post-deinstall
	usbsas-analyzer-server.pre-deinstall
	usbsas-hid.post-install
	usbsas-hid.pre-deinstall
	usbsas-hid.post-deinstall
"
arch="noarch"
depends="
	usbsas-server
	usbsas-server-openrc
	usbsas-kiosk
	usbsas-kiosk-openrc
	usbsas-analyzer-server
	usbsas-analyzer-server-openrc
	usbsas-tools
	usbsas-hid
	usbsas-hid-openrc
"

	#linux-headers
makedepends="
	alpine-sdk
	cargo
	clang
	clang-libclang
	eudev-dev
	gcc
	krb5-dev
	libusb-dev
	libseccomp-dev
	llvm-dev
	musl-dev
	pkgconf
"
options="!check" # TODO: run tests?
# TODO: mkinitfs trigger/hook on relevant subpkgs (server & hid if I'm not mistaken)?

_build_dir="$srcdir/usbsas-$_ref"
build() {
	cd $_build_dir
	export USBSAS_BIN_PATH=/usr/libexec
	cargo build --release --workspace
}

# This is a meta-package
package() {
	mkdir -p "$pkgdir"
}

server() {
	depends="$_common_deps eudev udev-init-scripts libusb libseccomp"
	pkgdesc="A free and open source (GPLv3) tool and framework for securely reading untrusted USB mass storage devices. (server)"

	cd $_build_dir
	install -Dm 755 target/release/usbsas-usbsas \
		target/release/usbsas-analyzer \
		target/release/usbsas-jsonparser \
		target/release/usbsas-cmdexec \
		target/release/usbsas-dev2scsi \
		target/release/usbsas-downloader \
		target/release/usbsas-files2fs \
		target/release/usbsas-files2tar \
		target/release/usbsas-local2files \
		target/release/usbsas-fs2dev \
		target/release/usbsas-identifier \
		target/release/usbsas-scsi2files \
		target/release/usbsas-tar2files \
		target/release/usbsas-uploader \
		target/release/usbsas-usbdev \
		-t "$subpkgdir"/usr/libexec/
	install -Dm 644 usbsas-usbsas/assets/usbsas.conf -t "$subpkgdir"/etc/modprobe.d/
	install -Dm 644 usbsas-usbsas/assets/99-usbsas.rules -t "$subpkgdir"/etc/udev/rules.d/
	install -Dm 644 config.example.toml "$subpkgdir"/etc/usbsas/config.toml
}
server_openrc() {
	depends="usbsas-server"
	install -Dm 755 "$srcdir"/usbsas-server -t "$subpkgdir"/etc/init.d/
}

kiosk() {
	depends="$_common_deps usbsas-server cage wayland-libs-egl font-noto font-noto-emoji"
	pkgdesc="A free and open source (GPLv3) tool and framework for securely reading untrusted USB mass storage devices. (client)"
	pkgver=$(grep '^version = ' $_build_dir/usbsas-client/Cargo.toml | cut -d'"' -f2)

	cd $_build_dir
	install -Dm 755 target/release/usbsas-client -t "$subpkgdir"/usr/bin/
}
kiosk_openrc() {
	depends="usbsas-kiosk seatd seatd-launch"
	install -Dm 755 "$srcdir"/usbsas-kiosk -t "$subpkgdir"/etc/init.d/
}

analyzer_server() {
	depends="$_common_deps clamav-daemon freshclam"
	pkgdesc="A free and open source (GPLv3) tool and framework for securely reading untrusted USB mass storage devices. (analyzer server)"
	pkgver=$(grep '^version = ' $_build_dir/usbsas-analyzer-server/Cargo.toml | cut -d'"' -f2)

	cd $_build_dir
	install -Dm 755 target/release/usbsas-analyzer-server -t "$subpkgdir"/usr/bin/
}
analyzer_server_openrc() {
	depends="usbsas-analyzer-server"
	install -Dm 755 "$srcdir"/usbsas-analyzer-server -t "$subpkgdir"/etc/init.d/
}

tools() {
	depends="usbsas-server fuse3"
	pkgdesc="A free and open source (GPLv3) tool and framework for securely reading untrusted USB mass storage devices. (tools)"
	pkgver=$(grep '^version = ' $_build_dir/usbsas-tools/Cargo.toml | cut -d'"' -f2)

	cd $_build_dir
	install -Dm 755 target/release/usbsas-fuse-mount \
		target/release/usbsas-imager \
		target/release/usbsas-net \
		target/release/usbsas-fswriter \
		target/release/usbsas-devmonitor \
		-t "$subpkgdir"/usr/bin/
}

hid() {
	depends="eudev udev-init-scripts usbsas-kiosk"
	pkgdesc="A free and open source (GPLv3) tool and framework for securely reading untrusted USB mass storage devices. (hid)"
	pkgver=$(grep '^version = ' $_build_dir/usbsas-hid/Cargo.toml | cut -d'"' -f2)

	cd $_build_dir
	install -Dm 755 target/release/hid-dealer target/release/hid-user -t "$subpkgdir"/usr/libexec/
	install -Dm 644 usbsas-hid/assets/99-usbsas-hid.rules -t "$subpkgdir"/etc/udev/rules.d/
	install -Dm 644 usbsas-hid/assets/hid.conf -t "$subpkgdir"/etc/modprobe.d/
	install -Dm 644 usbsas-hid/assets/uinput.conf -t "$subpkgdir"/etc/modules-load.d/
}
hid_openrc() {
	depends="usbsas-hid"
	install -Dm 755 "$srcdir"/hid-dealer -t "$subpkgdir"/etc/init.d/
}

