FROM alpine:3.24

RUN apk add -q --purge \
    alpine-sdk \
    cargo \
    clang \
    clang-libclang \
    eudev-dev \
    gcc \
    krb5-dev \
    libusb-dev \
    libseccomp-dev \
    llvm-dev \
    musl-dev \
    pkgconf \
    protoc

ENTRYPOINT ["/bin/ash", "-c"]
CMD ["if [[ ! -f /root/.abuild/*.rsa ]]; then abuild-keygen -na && cp /root/.abuild/*.rsa.pub /etc/apk/keys; fi; cd /usbsas-apk && abuild -F checksum && abuild -KFc"]
